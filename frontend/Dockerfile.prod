# The built app served by Caddy, which also proxies the API to Django (docker-compose.prod.yml).
FROM node:22-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG VITE_DEMO_MODE=true
ENV VITE_DEMO_MODE=$VITE_DEMO_MODE VITE_API_URL=
RUN npx vite build

FROM caddy:2.8-alpine
COPY --from=build /app/dist /srv
COPY Caddyfile.prod /etc/caddy/Caddyfile
