# Copy to .env and adjust. Every variable is optional for a local demo.

# Django signing key. Use a long random string anywhere except your laptop.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Database. Docker Compose sets this for you; without Docker the default is SQLite.
# DATABASE_URL=postgres://pulse:pulse@localhost:5432/pulse

# Redis for Celery and caching. Leave empty to run background jobs inline (no worker needed).
# REDIS_URL=redis://localhost:6379/0

# Comma-separated hosts Django will answer to, and origins allowed to call the API.
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# AI provider: "anthropic" or "openai". Leave AI_API_KEY empty to run fully on deterministic fallbacks.
AI_PROVIDER=anthropic
AI_API_KEY=
# Stronger model for task decomposition and quiz questions.
AI_MODEL_PLANNER=claude-sonnet-5-5
# Cheap, fast model for session titles, plan summary and notification variations.
AI_MODEL_LIGHT=claude-haiku-5-5

# Web Push keys. Generate with: python backend/manage.py generate_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# The frontend needs the public key too.
VITE_VAPID_PUBLIC_KEY=

# Email fallback. The console backend prints emails to the server log.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Pulse <pulse@example.com>

# true: Celery Beat runs periodic scans. false: call `manage.py run_periodic` from cron every 10 minutes.
USE_CELERY_BEAT=true
# Shared secret for the protected cron endpoint (POST /api/v1/demo/cron with X-Cron-Token).
CRON_TOKEN=

# Placement solver: greedy (default) or cpsat (needs `pip install ortools`, falls back to greedy).
SOLVER=greedy

# First day of the seeded term (YYYY-MM-DD). Empty = 4 weeks before today.
TERM_START_DATE=

# Enables time-travel, the demo control page and demo accounts on the login screen.
DEMO_MODE=true
VITE_DEMO_MODE=true

# Where the student is sent for campus support in supportive mode.
CAMPUS_SUPPORT_URL=https://988lifeline.org/

# Share of correct answers that earns the "sharp" badge on chapter quizzes.
QUIZ_SHARP_THRESHOLD=0.6

# Frontend origin, used in email links.
FRONTEND_URL=http://localhost:5173
