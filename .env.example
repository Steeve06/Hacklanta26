# Copy to .env and adjust. Every variable is optional for a local demo.

# Django signing key. `make setup` (or `python backend/manage.py init_env .env`) fills it in.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Database. Docker Compose sets this for you; without Docker the default is SQLite.
# DATABASE_URL=postgres://pulse:pulse@localhost:5432/pulse

# Redis for Celery and caching. Leave empty to run background jobs inline (no worker needed).
# REDIS_URL=redis://localhost:6379/0

# Comma-separated hosts Django will answer to, and origins allowed to call the API.
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# AI provider: "anthropic" or "openai". Leave AI_API_KEY empty to run fully on deterministic fallbacks.
AI_PROVIDER=anthropic
AI_API_KEY=
# Stronger model for task decomposition and quiz questions.
AI_MODEL_PLANNER=claude-sonnet-5-5
# Cheap, fast model for session titles, plan summary and notification variations.
AI_MODEL_LIGHT=claude-haiku-5-5
# Let the light model reword reminder templates for variety (guardrails still apply).
NOTIFICATION_AI_VARIATION=false

# Web Push keys. `make setup` (or `python backend/manage.py init_env .env`) fills them in.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Email fallback. The console backend prints emails to the server log.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Leon <leon@example.com>

# true: Celery Beat runs the periodic jobs. false: run them every 10 minutes from cron, either
# `python manage.py run_periodic` or POST /api/cron with header X-Cron-Token.
USE_CELERY_BEAT=true
# Shared secret for POST /api/cron. Empty disables the endpoint.
CRON_TOKEN=

# Placement solver: greedy (default) or cpsat (needs `pip install ortools`, falls back to greedy).
SOLVER=greedy

# Where uploaded homework files are stored (a mounted disk in production).
# MEDIA_ROOT=backend/media

# Request rate limits (DRF throttle syntax).
# THROTTLE_WRITE=120/min
# Sign-in, sign-up and password-reset requests, per IP and per email.
# THROTTLE_AUTH=5/min
# THROTTLE_REGENERATE=5/hour
# Messages to the schedule chat, per student.
# THROTTLE_ASSISTANT=30/hour

# Study checks: right answers out of 4 needed to pass, and the minimum seconds per card
# before a finished attempt counts.
# STUDY_CHECK_PASS_MARK=3
# STUDY_CHECK_SECONDS_PER_CARD=4
# Seconds a student has for one try at a study check, once they press Start.
# STUDY_CHECK_TIME_LIMIT=180

# Time zone class meeting times are entered in. Students elsewhere see a "campus time" note.
# CAMPUS_TIMEZONE=America/New_York

# First day of the seeded term (YYYY-MM-DD). Empty = 4 weeks before today.
TERM_START_DATE=

# Enables time-travel, the demo control page and demo accounts on the login screen.
DEMO_MODE=true
VITE_DEMO_MODE=true

# Where the student is sent for campus support in supportive mode.
CAMPUS_SUPPORT_URL=https://988lifeline.org/

# Frontend origin, used in email links.
FRONTEND_URL=http://localhost:5173

# Where the browser sends API calls. Leave empty to use the same origin (the Vite dev proxy
# locally, the vercel.json rewrite in production).
VITE_API_URL=

# Production only: SameSite policy for the refresh-token cookie (Lax, or None if the API is on
# another site and not proxied).
# REFRESH_COOKIE_SAMESITE=Lax
